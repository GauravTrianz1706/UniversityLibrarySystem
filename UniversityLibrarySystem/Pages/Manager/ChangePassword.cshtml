@* Migrated from ASP.NET Web Forms UserControl (<%@ Control %>) to ASP.NET Core Razor partial view *@
@* Rule cr-dotnet-0026: Web Forms Usage - Replaced <%@ Control %> directive and UserControl with ASP.NET Core Razor partial view *@
@* This file replaces Manager/ChangePassword.ascx as a Razor partial view (ChangePassword.cshtml) *@
@model UniversityLibrarySystem.Manager.ChangePasswordViewModel
<style>
    .BDC_CaptchaIconsDiv { display: none; }
</style>
<div class="container-xxl flex-grow-1 container-p-y">
    <div class="row">
        <div class="col-md-12">
            <div class="card mb-4">
                <h5 class="card-header">تغییر کلمه عبور</h5>
                <form class="card-body" method="post">
                    @Html.AntiForgeryToken()
                    <div class="row g-3">
                        <div class="col-12">
                            @if (!string.IsNullOrEmpty(Model.AlertMessage))
                            {
                                <div class="alert alert-@Model.AlertType" role="alert">@Html.Raw(Model.AlertMessage)</div>
                            }
                        </div>
                        <div class="col-md-7">
                            <div class="form-password-toggle">
                                <label class="form-label" for="CurrentPassword">رمز عبور کنونی</label>
                                <div class="input-group input-group-merge">
                                    <input type="password" id="CurrentPassword" name="CurrentPassword" class="form-control text-start" dir="ltr" placeholder="············" required minlength="8" pattern="^[A-Za-z\d@@$!%*?&amp;]{8,}$">
                                    <span class="input-group-text cursor-pointer"><i class="bx bx-hide"></i></span>
                                </div>
                                @if (Model.ShowInvalidCurrentPassword)
                                {
                                    <span class="badge bg-label-danger">رمز عبور کنونی وارد شده نادرست است</span>
                                }
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-password-toggle">
                                <label class="form-label" for="NewPassword">رمز عبور</label>
                                <div class="input-group input-group-merge">
                                    <input type="password" id="NewPassword" name="NewPassword" class="form-control text-start" dir="ltr" placeholder="············" required minlength="8" pattern="^[A-Za-z\d@@$!%*?&amp;]{8,}$">
                                    <span class="input-group-text cursor-pointer"><i class="bx bx-hide"></i></span>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-password-toggle">
                                <label class="form-label" for="ConfirmPassword">تایید رمز عبور</label>
                                <div class="input-group input-group-merge">
                                    <input type="password" id="ConfirmPassword" name="ConfirmPassword" class="form-control text-start" dir="ltr" placeholder="············" required minlength="8">
                                    <span class="input-group-text cursor-pointer"><i class="bx bx-hide"></i></span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <hr class="my-4 mx-n4">
                    <div class="pt-4">
                        <button type="submit" class="btn btn-primary me-sm-3 me-1">ثبت</button>
                        <a href="./ChangePassword" class="btn btn-label-secondary">بازگشت</a>
                    </div>
                    <script>window.history.replaceState(null, null, window.location.href.split('?')[0]);</script>
                </form>
            </div>
        </div>
    </div>
</div>
