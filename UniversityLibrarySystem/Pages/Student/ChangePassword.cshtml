@* Migrated from ASP.NET Web Forms UserControl to ASP.NET Core Razor Pages partial view *@
@* Rule cr-dotnet-0026: Web Forms Usage - Replaced <%@ Control %> directive, BotDetect, runat="server", asp:* Web Forms controls *@
@* Replaced: Web Forms server controls with standard HTML form elements for Razor Pages *@
@using Microsoft.AspNetCore.Mvc.RazorPages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
<style>
    .BDC_CaptchaIconsDiv {
        display: none;
    }
</style>
<div class="container-xxl flex-grow-1 container-p-y">
    <div class="row">
        <div class="col-md-12">
            <div class="card mb-4">
                <h5 class="card-header">تغییر کلمه عبور</h5>
                <form class="card-body" method="post">
                    @Html.AntiForgeryToken()
                    <div class="row g-3">
                        <div class="col-12">
                            @if (!string.IsNullOrEmpty(ViewData["LiteralMessage"] as string))
                            {
                                @Html.Raw(ViewData["LiteralMessage"])
                            }
                        </div>
                        <div class="col-md-7">
                            <div class="form-password-toggle">
                                <label class="form-label" for="CurrentPassword">رمز عبور کنونی</label>
                                <div class="input-group input-group-merge">
                                    <input type="password" id="CurrentPassword" name="CurrentPassword" class="form-control text-start" dir="ltr" placeholder="············" aria-describedby="multicol-password2" required minlength="8">
                                    <span class="input-group-text cursor-pointer" id="multicol-password2"><i class="bx bx-hide"></i></span>
                                </div>
                                @if (ViewData["InvalidCurrentPassword"] as bool? == true)
                                {
                                    <label class="badge bg-label-danger">رمز عبور کنونی وارد شده نادرست است</label>
                                }
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-password-toggle">
                                <label class="form-label" for="txtPassword">رمز عبور</label>
                                <div class="input-group input-group-merge">
                                    <input type="password" id="txtPassword" name="txtPassword" class="form-control text-start" dir="ltr" placeholder="············" aria-describedby="multicol-password2" required minlength="8">
                                    <span class="input-group-text cursor-pointer" id="multicol-password2"><i class="bx bx-hide"></i></span>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-password-toggle">
                                <label class="form-label" for="txtRePassword">تایید رمز عبور</label>
                                <div class="input-group input-group-merge">
                                    <input type="password" id="txtRePassword" name="txtRePassword" class="form-control text-start" dir="ltr" placeholder="············" aria-describedby="multicol-confirm-password2" required minlength="8">
                                    <span class="input-group-text cursor-pointer" id="multicol-confirm-password2"><i class="bx bx-hide"></i></span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <hr class="my-4 mx-n4">
                    <div class="pt-4">
                        <button type="submit" class="btn btn-primary me-sm-3 me-1">ثبت</button>
                        <a href="./ChangePassword" class="btn btn-label-secondary">بازگشت</a>
                    </div>
                    <script>window.history.replaceState(null, null, window.location.href.split('?')[0]);</script>
                </form>
            </div>
        </div>
    </div>
</div>
